# Copy to .env (it is git-ignored) and fill in. The relay reads it; it never reaches a browser.
NEARAI_API_KEY=
# PORT=8790

# Sealed knowledge bases (optional). SEAL_SECRET makes sealing reproducible, so you can audit later what was sealed in a given request.
# Use any long random string, e.g.  openssl rand -hex 32  and keep it: changing it means old sealed messages can no longer be audited.
# SEAL_SECRET=
# AUDIT_TOKEN turns on POST /s/<site>/audit for the owner. Use another long random string.
# AUDIT_TOKEN=
