{
  "name": "@veil/site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5180",
    "build": "npm --prefix ../widget run build && node scripts/widget.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --port 5181",
    "record": "tsx scripts/record.ts",
    "typecheck": "tsc --noEmit",
    "build:site": "node scripts/widget.mjs && tsc --noEmit && vite build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
